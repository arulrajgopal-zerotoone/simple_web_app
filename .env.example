# Local development only. In Azure App Service these come from
# Application Settings (SQL_CONNECTION_STRING is injected via Key Vault)

# Either a full SQLAlchemy URL (mssql+pyodbc://...) or a raw ODBC connection
# string — the app detects which one you gave it.
SQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=tcp:<server_name>,1433;Database=<database_name>;Uid=<username>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Secret key used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=60
